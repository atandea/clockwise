pipeline {
    agent {
        label 'debian && linux && docker'
    }

    environment {
        PATH = "/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        RUSTUP_HOME = "/usr/local/rustup"
        CARGO_HOME = "/usr/local/cargo"
        CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER = "x86_64-w64-mingw32-gcc"
        PKG_CONFIG_ALLOW_CROSS = "1"
        PKG_CONFIG_PATH = ""
    }

    stages {
        stage('Debug Tools') {
            steps {
                sh 'printenv && which cargo && cargo --version && which node && node --version'
            }
        }
    stage('Setup & Prepare') {
        steps {
            dir('/home/jenkins/agent/workspace/clockwise-local') {
                sh '''
                    set -ex
                    echo '--- Installing Dependencies & Building Frontend ---'
                    (cd clockwise-server && rm -rf node_modules && npm ci && npm run build)
                    (cd clockwise-dashboard && rm -rf node_modules && npm ci && npm run build)
                
                    echo '--- Preparing Sidecar Directories ---'
                    mkdir -p clockwise-server/client
                    cp -r clockwise-dashboard/build/* clockwise-server/client/
                    mkdir -p clockwise-dashboard/src-tauri/bin
                '''
            }
        }
    }

    stage('Test') {
        steps {
            dir('/home/jenkins/agent/workspace/clockwise-local') {
                    sh '''
                        set -ex
                        echo '--- Running Backend Unit Tests with Coverage ---'
                        (cd clockwise-server && npm run test:cov)
                        
                        echo '--- Running Backend E2E Tests ---'
                        (cd clockwise-server && npm run test:e2e)

                        echo '--- Running Frontend Unit Tests with Coverage ---'
                        (cd clockwise-dashboard && npm run test:cov)
                    '''
                }
            }
        }

        stage('Build Linux') {
            steps {
                dir('/home/jenkins/agent/workspace/clockwise-local') {
                    sh '''
                        set -ex
                        echo '--- Building Server Sidecar Binary (Linux) ---'
                        (cd clockwise-server && npx @yao-pkg/pkg@latest . -t node26-linux-x64 --output ../clockwise-dashboard/src-tauri/bin/clockwise-server-x86_64-unknown-linux-gnu)
                        
                        echo '--- Building Tauri App (.deb) ---'
                        (cd clockwise-dashboard && npm run tauri build -- --bundles deb)
                    '''
                }
            }
        }

        stage('Build Windows') {
            steps {
                dir('/home/jenkins/agent/workspace/clockwise-local') {
                    sh '''
                        set -ex
                        echo '--- Building Server Sidecar Binary (Windows) ---'
                        (cd clockwise-server && npx @yao-pkg/pkg@latest . -t node26-win-x64 --output ../clockwise-dashboard/src-tauri/bin/clockwise-server-x86_64-pc-windows-gnu.exe)
                
                        echo '--- Building Tauri App (.exe) ---'
                        export PKG_CONFIG_ALLOW_CROSS=1
                        export PKG_CONFIG=/usr/bin/x86_64-w64-mingw32-pkg-config || true
                        (cd clockwise-dashboard && npm run tauri build -- --target x86_64-pc-windows-gnu)
                    '''
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir('/home/jenkins/agent/workspace/clockwise-local') {
                    sh '''
                        echo '--- Running Clippy for Rust analysis ---'
                        (cd clockwise-dashboard/src-tauri && cargo clippy --message-format=json > clippy-report.json || true)
                    '''
                    withSonarQubeEnv('SonarQube') {
                        sh 'sonar-scanner'
                    }
                }
            }
        }
    }

    post {
        always {
            dir('/home/jenkins/agent/workspace/clockwise-local') {
                archiveArtifacts artifacts: 'clockwise-dashboard/src-tauri/target/release/bundle/deb/*.deb, clockwise-dashboard/src-tauri/target/release/bundle/appimage/*.AppImage, clockwise-dashboard/src-tauri/target/x86_64-pc-windows-gnu/release/bundle/nsis/*.exe', allowEmptyArchive: true
            }
        }
    }
}
