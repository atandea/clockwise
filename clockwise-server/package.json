{
  "name": "clockwise-server",
  "engines": {
    "node": ">=26.9.0"
  },
  "version": "1.1.6",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "bin": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --config ./vitest.config.mts",
    "test:watch": "vitest --config ./vitest.config.mts",
    "test:cov": "vitest run --config ./vitest.config.mts --coverage",
    "test:debug": "node --inspect-brk ./node_modules/vitest/vitest.mjs --config ./vitest.config.mts",
    "test:e2e": "vitest run --config ./vitest.e2e.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "compression": "^1.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@nestjs/core@11.1.24": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.18": true
  }
}
