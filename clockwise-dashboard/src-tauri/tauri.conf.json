{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clockwise-dashboard",
  "version": "1.1.0",
  "identifier": "com.clockwise.dashboard",
  "build": {
    "beforeDevCommand": "npm run build:server && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:server && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Clockwise Dashboard",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/clockwise-server"
    ]
  }
}
