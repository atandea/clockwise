{
  "name": "clockwise",
  "engines": {
    "node": "26"
  },
  "version": "1.1.7",
  "description": "",
  "type": "module",
  "imports": {
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "generate:version": "node ../scripts/generate-version.mjs",
    "build:server": "node ../scripts/build-server.mjs",
    "predev": "npm run generate:version",
    "prebuild": "npm run generate:version",
    "pretauri": "npm run generate:version",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "npx tauri",
    "dev:prod": "npm run build && npx tauri dev --release --config '{\"build\": {\"devUrl\": null}}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7",
    "undici": "^7.30.1"
  }
}