{
    "$schema": "https://schema.tauri.app/v2/config.json",
    "productName": "clockwise-timer",
    "version": "0.1.0",
    "identifier": "com.clockwise.timer",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Clockwise Timer",
                "width": 250,
                "height": 130,
                "resizable": true,
                "fullscreen": false,
                "alwaysOnTop": true,
                "decorations": false,
                "transparent": true,
                "shadow": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}